OPENAI_API_KEY=
# 任意 OpenAI-compatible 端点均可；GLM 示例：
# OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
OPENAI_MODEL=glm-5.3-flash
GITHUB_TOKEN=

# RAG 策略：off、recall（只读）、learn（不召回只学习）或 evolve（召回并学习）。
REPO_AGENT_MEMORY_MODE=learn
REPO_AGENT_MEMORY_RECALL_LIMIT=4

# CLI 的独立查询提取调用；设置模型后在 Coordinator 召回前启用。
# 留空时沿用原始问题检索。接口和密钥留空时复用 OPENAI_BASE_URL / OPENAI_API_KEY。
REPO_AGENT_MEMORY_QUERY_MODEL=
REPO_AGENT_MEMORY_QUERY_BASE_URL=
REPO_AGENT_MEMORY_QUERY_API_KEY=
REPO_AGENT_MEMORY_QUERY_MAX_OUTPUT_TOKENS=4096

# 无 API 额度时可按 SWE-bench instance_id 回放历史 predictions.json。
REPO_AGENT_EXECUTION_MODE=live
REPO_AGENT_REPLAY_PREDICTIONS=
# 可省略；默认读取 predictions 文件同级的 logs/<instance_id>/report.json。
REPO_AGENT_REPLAY_REPORTS_ROOT=

# 兼容旧的“整任务 Worker”启动模式；启用 pipeline 后不再使用这个值。
REPO_AGENT_WORKER_CONCURRENCY=1
# 默认启用按角色拆分的可靠队列。每个角色最多三个实例，空闲实例会继续消费本角色队列。
REPO_AGENT_PIPELINE_ENABLED=true
REPO_AGENT_PIPELINE_AGENT_CONCURRENCY=3
# 仅 replay 模式生效，使监控页面能观察到各个修复阶段；设为 0 可关闭。
REPO_AGENT_REPLAY_STAGE_DELAY_SECONDS=10

# 进程内无状态子 Agent Runtime 池；池耗尽时调用方异步等待空闲槽位。
# 所有角色池都强制限制在 1-3 个 Runtime。Runtime 无状态可复用，任务上下文由一次性
# AgentSession 隔离，槽位不足时对应角色队列会等待而不会串用会话。
REPO_AGENT_ROLE_POOL_SIZES=coordinator=2,research=3,reproducer=2,implement=3,patch_review=2,verify=2,failure_review=2
REPO_AGENT_ROLE_POOL_TIMEOUT_SECONDS=600
